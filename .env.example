# AI Clipper production environment configuration

# Container/public bind. Use 127.0.0.1 when placing Docker behind a TLS reverse proxy.
HOST_BIND=0.0.0.0
PORT=8080

# Download the free local Whisper model once with:
# python backend/scripts/prepare_offline.py
# For a custom model directory, set WHISPER_MODEL_DIR to the prepared directory.
WHISPER_MODEL_DIR=

# Worker and housekeeping limits.
MAX_CONCURRENT_WORKERS=2
CLEANUP_HOURS=48
MAX_UPLOAD_SIZE_MB=1024
MAX_VIDEO_DURATION_SECONDS=7200
MAX_TARGET_CLIPS=6
MAX_CUSTOM_WORDS=500

# Deployment posture. Generate a unique long random value for every hosted instance.
ENVIRONMENT=production
ADMIN_API_KEY=
REQUIRE_ADMIN_KEY=true
# Leave empty for the bundled same-origin frontend; set a comma-separated list for a separate frontend.
ALLOWED_ORIGINS=
